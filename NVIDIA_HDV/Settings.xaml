<Window
    x:Class="NVIDIA_HDV.Settings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:NVIDIA_HDV"
    mc:Ignorable="d"
    Width="400"
    Height="200"
    Title="NVIDIA_HDV @ FeiLingshu"
    Background="#FF202020"
    WindowStyle="SingleBorderWindow"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanMinimize"
    ShowActivated="True"
    ShowInTaskbar="True"
    KeyboardNavigation.TabNavigation="None"
    FocusVisualStyle="{x:Null}"
    Icon="/favicon.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="0"
            UseAeroCaptionButtons="False"
            NonClientFrameEdges="None"
            GlassFrameThickness="0,1,0,0"
            ResizeBorderThickness="0"
            CornerRadius="0">
        </WindowChrome>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush
            x:Key="Green"
            Color="#FF6CCB7B" />
        <SolidColorBrush
            x:Key="Yellow"
            Color="#FFFFB900" />
        <SolidColorBrush
            x:Key="Red"
            Color="#FFE81123" />
        <SolidColorBrush
            x:Key="Blue"
            Color="#FF60CDFF" />
        <SolidColorBrush
            x:Key="DarkBg"
            Color="#FF202020" />
        <SolidColorBrush
            x:Key="DimBg"
            Color="#FF303030" />
        <SolidColorBrush
            x:Key="LightBg"
            Color="#FF9E9E9E" />
        <SolidColorBrush
            x:Key="DarkBorder"
            Color="#FF404040" />
        <SolidColorBrush
            x:Key="DimBorder"
            Color="#FF606060" />
        <SolidColorBrush
            x:Key="DimText"
            Color="#FF808080" />
        <SolidColorBrush
            x:Key="LightText"
            Color="#FFC0C0C0" />
        <SolidColorBrush
            x:Key="WhiteText"
            Color="#FFF0F0F0" />
        <FontFamily
            x:Key="DefaultFont">Consolas, Microsoft YaHei</FontFamily>
        <DropShadowEffect
            x:Key="HeavyShadow"
            BlurRadius="10"
            Color="#FF000000"
            Direction="270"
            Opacity="0.5"
            RenderingBias="Performance"
            ShadowDepth="1" />
    </Window.Resources>
    <Grid>
        <Grid.Resources>
            <Style
                TargetType="{x:Type Control}">
                <Setter
                    Property="FocusVisualStyle"
                    Value="{x:Null}" />
            </Style>
            <Style
                x:Key="TextBase"
                TargetType="Control"
                BasedOn="{StaticResource {x:Type Control}}">
                <Setter
                    Property="FontFamily"
                    Value="{StaticResource DefaultFont}" />
                <Setter
                    Property="FontSize"
                    Value="14" />
                <Setter
                    Property="FontWeight"
                    Value="Bold" />
                <Setter
                    Property="SnapsToDevicePixels"
                    Value="True" />
                <Setter
                    Property="UseLayoutRounding"
                    Value="True" />
                <Setter
                    Property="Foreground"
                    Value="{StaticResource LightText}" />
            </Style>
            <Style
                x:Key="CustomCheckBoxStyle"
                TargetType="CheckBox"
                BasedOn="{StaticResource {x:Type Control}}">
                <Setter
                    Property="HorizontalAlignment"
                    Value="Left" />
                <Setter
                    Property="VerticalAlignment"
                    Value="Bottom" />
                <Setter
                    Property="HorizontalContentAlignment"
                    Value="Left" />
                <Setter
                    Property="VerticalContentAlignment"
                    Value="Center" />
                <Setter
                    Property="Foreground"
                    Value="{StaticResource LightText}" />
                <Setter
                    Property="Background"
                    Value="Transparent" />
                <Setter
                    Property="BorderBrush"
                    Value="{x:Null}" />
                <Setter
                    Property="BorderThickness"
                    Value="0" />
                <Setter
                    Property="Height"
                    Value="20" />
                <Setter
                    Property="Template">
                    <Setter.Value>
                        <ControlTemplate
                            TargetType="CheckBox">
                            <Grid
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition
                                        Width="Auto" />
                                    <ColumnDefinition
                                        Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid
                                    Grid.Column="0"
                                    Width="16"
                                    Height="16">
                                    <Rectangle
                                        x:Name="Outer"
                                        RadiusX="2"
                                        RadiusY="2"
                                        Stroke="{StaticResource DimBorder}"
                                        StrokeThickness="2" />
                                    <Rectangle
                                        x:Name="Inner"
                                        Width="10"
                                        Height="10"
                                        Fill="{StaticResource LightBg}"
                                        Opacity="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </Grid>
                                <ContentPresenter
                                    Grid.Column="1"
                                    RecognizesAccessKey="True" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger
                                    Property="IsMouseOver"
                                    Value="True">
                                    <Setter
                                        TargetName="Outer"
                                        Property="Stroke"
                                        Value="{StaticResource Blue}" />
                                </Trigger>
                                <Trigger
                                    Property="IsChecked"
                                    Value="True">
                                    <Setter
                                        TargetName="Inner"
                                        Property="Opacity"
                                        Value="1" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style
                x:Key="CustomRadioButtonStyle"
                TargetType="RadioButton"
                BasedOn="{StaticResource {x:Type Control}}">
                <Setter
                    Property="HorizontalAlignment"
                    Value="Left" />
                <Setter
                    Property="VerticalAlignment"
                    Value="Bottom" />
                <Setter
                    Property="HorizontalContentAlignment"
                    Value="Left" />
                <Setter
                    Property="VerticalContentAlignment"
                    Value="Center" />
                <Setter
                    Property="Foreground"
                    Value="{StaticResource LightText}" />
                <Setter
                    Property="Background"
                    Value="Transparent" />
                <Setter
                    Property="BorderBrush"
                    Value="{x:Null}" />
                <Setter
                    Property="BorderThickness"
                    Value="0" />
                <Setter
                    Property="Height"
                    Value="20" />
                <Setter
                    Property="Template">
                    <Setter.Value>
                        <ControlTemplate
                            TargetType="RadioButton">
                            <Grid
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition
                                        Width="Auto" />
                                    <ColumnDefinition
                                        Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid
                                    Grid.Column="0"
                                    Width="14"
                                    Height="14">
                                    <Rectangle
                                        x:Name="Outer"
                                        RadiusX="4"
                                        RadiusY="4"
                                        Stroke="{StaticResource DimBorder}"
                                        StrokeThickness="2" />
                                    <Rectangle
                                        x:Name="Inner"
                                        Width="8"
                                        Height="8"
                                        RadiusX="2"
                                        RadiusY="2"
                                        Fill="{StaticResource LightBg}"
                                        Opacity="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </Grid>
                                <ContentPresenter
                                    Grid.Column="1"
                                    RecognizesAccessKey="True" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger
                                    Property="IsMouseOver"
                                    Value="True">
                                    <Setter
                                        TargetName="Outer"
                                        Property="Stroke"
                                        Value="{StaticResource Blue}" />
                                </Trigger>
                                <Trigger
                                    Property="IsChecked"
                                    Value="True">
                                    <Setter
                                        TargetName="Inner"
                                        Property="Opacity"
                                        Value="1" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style
                x:Key="FocusHighlightStyle"
                TargetType="TextBox"
                BasedOn="{StaticResource {x:Type Control}}">
                <Setter
                    Property="VerticalAlignment"
                    Value="Center" />
                <Setter
                    Property="TextAlignment"
                    Value="Center" />
                <Setter
                    Property="Background"
                    Value="Transparent" />
                <Setter
                    Property="BorderBrush"
                    Value="{StaticResource DarkBorder}" />
                <Setter
                    Property="BorderThickness"
                    Value="0,0,0,2" />
                <Setter
                    Property="Foreground"
                    Value="{StaticResource LightText}" />
                <Setter
                    Property="SelectionBrush"
                    Value="{StaticResource DimText}" />
                <Setter
                    Property="SelectionTextBrush"
                    Value="{StaticResource LightText}" />
                <Setter
                    Property="CaretBrush"
                    Value="{StaticResource Blue}" />
                <Setter
                    Property="FontFamily"
                    Value="{StaticResource DefaultFont}" />
                <Setter
                    Property="FontSize"
                    Value="14" />
                <Setter
                    Property="FontWeight"
                    Value="Bold" />
                <Setter
                    Property="Width"
                    Value="45" />
                <Setter
                    Property="Height"
                    Value="20" />
                <Setter
                    Property="Margin"
                    Value="5,0" />
                <Setter
                    Property="InputMethod.IsInputMethodEnabled"
                    Value="False" />
                <Setter
                    Property="ContextMenu"
                    Value="{x:Null}" />
                <Setter
                    Property="IsUndoEnabled"
                    Value="False" />
                <Setter
                    Property="UndoLimit"
                    Value="1" />
                <Style.Triggers>
                    <Trigger
                        Property="IsFocused"
                        Value="True">
                        <Setter
                            Property="BorderBrush"
                            Value="{StaticResource Blue}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style
                x:Key="EnabledStyle"
                TargetType="TextBlock">
                <Setter
                    Property="Foreground"
                    Value="{StaticResource Blue}" />
                <Style.Triggers>
                    <DataTrigger
                        Binding="{Binding ElementName=GO, Path=IsEnabled}"
                        Value="False">
                        <Setter
                            Property="Foreground"
                            Value="{StaticResource DimText}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Resources>
        <Grid
            Height="30"
            VerticalAlignment="Top"
            HorizontalAlignment="Stretch"
            Background="#FF303030"
            x:Name="TITLE">
            <TextBlock
                Foreground="{StaticResource WhiteText}"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                FontFamily="{StaticResource DefaultFont}"
                FontSize="16"
                FontWeight="Bold"
                LineHeight="20"
                LineStackingStrategy="BlockLineHeight"
                SnapsToDevicePixels="True"
                UseLayoutRounding="True"
                Margin="10,6,10,4"
                Focusable="True"
                FocusVisualStyle="{x:Null}"
                x:Name="NULLPART">
                <Run
                    Text="NVIDIA_HDV" />
                <Run
                    FontSize="12"
                    Foreground="{StaticResource DimText}"
                    Text="作者：FeiLingshu" />
            </TextBlock>
            <Border
                Width="30"
                HorizontalAlignment="Right"
                Margin="0,0,1,0"
                x:Name="CLOSE">
                <Border.Background>
                    <SolidColorBrush
                        x:Name="CloseBG"
                        Color="#FF303030" />
                </Border.Background>
                <Path
                    Data="M0 0L10 10M0 10L10 0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Stroke="{StaticResource WhiteText}"
                    StrokeThickness="1"
                    IsHitTestVisible="False" />
                <Border.Triggers>
                    <EventTrigger
                        RoutedEvent="Mouse.MouseEnter">
                        <BeginStoryboard>
                            <Storyboard
                                FillBehavior="HoldEnd">
                                <ColorAnimation
                                    Storyboard.TargetName="CloseBG"
                                    Storyboard.TargetProperty="Color"
                                    To="#FFC42B1C"
                                    Duration="0:0:0.1">
                                    <ColorAnimation.EasingFunction>
                                        <SineEase
                                            EasingMode="EaseInOut" />
                                    </ColorAnimation.EasingFunction>
                                </ColorAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger
                        RoutedEvent="Mouse.MouseLeave">
                        <BeginStoryboard>
                            <Storyboard
                                FillBehavior="HoldEnd">
                                <ColorAnimation
                                    Storyboard.TargetName="CloseBG"
                                    Storyboard.TargetProperty="Color"
                                    To="#FF303030"
                                    Duration="0:0:0.1">
                                    <ColorAnimation.EasingFunction>
                                        <SineEase
                                            EasingMode="EaseInOut" />
                                    </ColorAnimation.EasingFunction>
                                </ColorAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
            </Border>
            <Border
                Width="30"
                HorizontalAlignment="Right"
                Margin="0,0,31,0"
                x:Name="MINI">
                <Border.Background>
                    <SolidColorBrush
                        x:Name="MiniBG"
                        Color="#FF303030" />
                </Border.Background>
                <Path
                    Data="M0 0L10 0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Stroke="{StaticResource WhiteText}"
                    StrokeThickness="1"
                    IsHitTestVisible="False" />
                <Border.Triggers>
                    <EventTrigger
                        RoutedEvent="Mouse.MouseEnter">
                        <BeginStoryboard>
                            <Storyboard
                                FillBehavior="HoldEnd">
                                <ColorAnimation
                                    Storyboard.TargetName="MiniBG"
                                    Storyboard.TargetProperty="Color"
                                    To="#FF404040"
                                    Duration="0:0:0.1">
                                    <ColorAnimation.EasingFunction>
                                        <SineEase
                                            EasingMode="EaseInOut" />
                                    </ColorAnimation.EasingFunction>
                                </ColorAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger
                        RoutedEvent="Mouse.MouseLeave">
                        <BeginStoryboard>
                            <Storyboard
                                FillBehavior="HoldEnd">
                                <ColorAnimation
                                    Storyboard.TargetName="MiniBG"
                                    Storyboard.TargetProperty="Color"
                                    To="#FF303030"
                                    Duration="0:0:0.1">
                                    <ColorAnimation.EasingFunction>
                                        <SineEase
                                            EasingMode="EaseInOut" />
                                    </ColorAnimation.EasingFunction>
                                </ColorAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
            </Border>
        </Grid>
        <Grid
            VerticalAlignment="Center"
            Margin="0,35,0,40"
            x:Name="MainArea">
            <Grid
                Height="20"
                VerticalAlignment="Top"
                Margin="10,0,10,0">
                <TextBlock
                    Foreground="{StaticResource DimText}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource DefaultFont}"
                    FontSize="14"
                    FontWeight="Bold"
                    TextAlignment="Left"
                    LineStackingStrategy="BlockLineHeight"
                    SnapsToDevicePixels="True"
                    UseLayoutRounding="True"
                    Margin="0,0,0,0"
                    Text="正在连接至 www.nvidia.cn ..."
                    x:Name="Net" />
                <TextBlock
                    Foreground="{StaticResource DimText}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource DefaultFont}"
                    FontSize="14"
                    FontWeight="Bold"
                    TextAlignment="Left"
                    LineStackingStrategy="BlockLineHeight"
                    SnapsToDevicePixels="True"
                    UseLayoutRounding="True"
                    Margin="0,0,0,0"
                    Text="未知"
                    x:Name="Net_Status" />
            </Grid>
            <Grid
                Height="20"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                Margin="10,25,10,0">
                <TextBlock
                    Foreground="{StaticResource WhiteText}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource DefaultFont}"
                    FontSize="14"
                    FontWeight="Bold"
                    TextAlignment="Left"
                    LineStackingStrategy="BlockLineHeight"
                    SnapsToDevicePixels="True"
                    UseLayoutRounding="True"
                    Text="查询数量：" />
                <TextBox
                    HorizontalAlignment="Left"
                    Text="50"
                    Margin="70,0,0,0"
                    x:Name="Count"
                    Style="{StaticResource FocusHighlightStyle}" />
                <CheckBox
                    HorizontalAlignment="Right"
                    x:Name="Standard"
                    Style="{StaticResource CustomCheckBoxStyle}">
                    <Border
                        Height="20">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource Yellow}"
                            FontFamily="{StaticResource DefaultFont}"
                            FontSize="14"
                            FontWeight="Bold"
                            Padding="5,1,0,0"
                            Text="启用Standard模式" />
                    </Border>
                </CheckBox>
            </Grid>
            <Grid
                Height="20"
                VerticalAlignment="Top"
                Margin="10,50,10,0">
                <TextBlock
                    Foreground="{StaticResource WhiteText}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource DefaultFont}"
                    FontSize="14"
                    FontWeight="Bold"
                    TextAlignment="Left"
                    LineStackingStrategy="BlockLineHeight"
                    SnapsToDevicePixels="True"
                    UseLayoutRounding="True"
                    Margin="0,0,0,0"
                    Text="驱动类别：" />
                <RadioButton
                    Margin="70,1,0,0"
                    x:Name="GameReady"
                    Style="{StaticResource CustomRadioButtonStyle}">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource DefaultFont}"
                        FontSize="14"
                        FontWeight="Bold"
                        Padding="5,1,0,0"
                        Text="Game Ready" />
                </RadioButton>
                <RadioButton
                    Margin="180,1,0,0"
                    x:Name="Studio"
                    Style="{StaticResource CustomRadioButtonStyle}">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource DefaultFont}"
                        FontSize="14"
                        FontWeight="Bold"
                        Padding="5,1,0,0"
                        Text="Studio" />
                </RadioButton>
            </Grid>
            <Grid
                Height="20"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                Margin="10,75,10,0">
                <TextBlock
                    Foreground="{StaticResource WhiteText}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource DefaultFont}"
                    FontSize="14"
                    FontWeight="Bold"
                    TextAlignment="Left"
                    LineStackingStrategy="BlockLineHeight"
                    SnapsToDevicePixels="True"
                    UseLayoutRounding="True"
                    Text="查询特定版本号：" />
                <TextBox
                    HorizontalAlignment="Left"
                    Width="60"
                    Text="0.00"
                    Margin="120,0,0,0"
                    x:Name="Version"
                    Style="{StaticResource FocusHighlightStyle}" />
            </Grid>
            <Grid
                Height="20"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                Margin="10,100,10,0">
                <TextBlock
                    Foreground="{StaticResource WhiteText}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource DefaultFont}"
                    FontSize="14"
                    FontWeight="Bold"
                    TextAlignment="Left"
                    LineStackingStrategy="BlockLineHeight"
                    SnapsToDevicePixels="True"
                    UseLayoutRounding="True"
                    Text="查询特定版本号：" />
                <TextBox
                    HorizontalAlignment="Left"
                    Text="0"
                    Margin="120,0,0,0"
                    x:Name="Release"
                    Style="{StaticResource FocusHighlightStyle}" />
            </Grid>
        </Grid>
        <Border
            Height="25"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Stretch"
            CornerRadius="5"
            Margin="10,0,10,10"
            x:Name="GO">
            <Border.Background>
                <SolidColorBrush
                    x:Name="ButtonBG"
                    Color="#FF303030" />
            </Border.Background>
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontFamily="{StaticResource DefaultFont}"
                FontSize="14"
                FontWeight="Bold"
                TextAlignment="Left"
                LineStackingStrategy="BlockLineHeight"
                SnapsToDevicePixels="True"
                UseLayoutRounding="True"
                Margin="0,0,0,0"
                IsHitTestVisible="False"
                Text="Go To https://www.nvidia.cn/drivers"
                Style="{StaticResource EnabledStyle}"/>
            <Border.Triggers>
                <EventTrigger
                    RoutedEvent="Mouse.MouseEnter">
                    <BeginStoryboard>
                        <Storyboard
                            FillBehavior="HoldEnd">
                            <ColorAnimation
                                Storyboard.TargetName="ButtonBG"
                                Storyboard.TargetProperty="Color"
                                To="#FF404040"
                                Duration="0:0:0.1">
                                <ColorAnimation.EasingFunction>
                                    <SineEase
                                        EasingMode="EaseInOut" />
                                </ColorAnimation.EasingFunction>
                            </ColorAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger
                    RoutedEvent="Mouse.MouseLeave">
                    <BeginStoryboard>
                        <Storyboard
                            FillBehavior="HoldEnd">
                            <ColorAnimation
                                Storyboard.TargetName="ButtonBG"
                                Storyboard.TargetProperty="Color"
                                To="#FF303030"
                                Duration="0:0:0.1">
                                <ColorAnimation.EasingFunction>
                                    <SineEase
                                        EasingMode="EaseInOut" />
                                </ColorAnimation.EasingFunction>
                            </ColorAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>
        </Border>
        <Grid.Effect>
            <StaticResource
                ResourceKey="HeavyShadow" />
        </Grid.Effect>
    </Grid>
</Window>
