<Window
    x:Class="NVIDIA_HDV.Notify"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:NVIDIA_HDV"
    mc:Ignorable="d"
    Background="#FF202020"
    Width="350"
    SizeToContent="Height"
    Title=""
    WindowStyle="SingleBorderWindow"
    ResizeMode="NoResize"
    ShowActivated="True"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterScreen"
    Icon="/favicon.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="0"
            UseAeroCaptionButtons="False"
            NonClientFrameEdges="None"
            GlassFrameThickness="0,1,0,0"
            ResizeBorderThickness="0"
            CornerRadius="0">
        </WindowChrome>
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid
            Height="30"
            VerticalAlignment="Top"
            Background="#FF333D4C"
            x:Name="TITLE"
            Panel.ZIndex="2">
            <Border
                Width="30"
                HorizontalAlignment="Right"
                Margin="0,0,1,0"
                x:Name="CLOSE">
                <Border.Background>
                    <SolidColorBrush
                        x:Name="CloseBG"
                        Color="#FF333D4C" />
                </Border.Background>
                <Path
                    Data="M 0,0 L 10,10 M 0,10 L 10,0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Stroke="#FFF0F0F0"
                    StrokeThickness="1"
                    IsHitTestVisible="False" />
                <Border.Triggers>
                    <EventTrigger
                        RoutedEvent="Mouse.MouseEnter">
                        <BeginStoryboard
                            HandoffBehavior="SnapshotAndReplace">
                            <Storyboard
                                FillBehavior="HoldEnd">
                                <ColorAnimation
                                    Storyboard.TargetName="CloseBG"
                                    Storyboard.TargetProperty="Color"
                                    To="#FFC42B1C"
                                    Duration="0:0:0.1">
                                    <ColorAnimation.EasingFunction>
                                        <SineEase
                                            EasingMode="EaseInOut" />
                                    </ColorAnimation.EasingFunction>
                                </ColorAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger
                        RoutedEvent="Mouse.MouseLeave">
                        <BeginStoryboard
                            HandoffBehavior="SnapshotAndReplace">
                            <Storyboard
                                FillBehavior="HoldEnd">
                                <ColorAnimation
                                    Storyboard.TargetName="CloseBG"
                                    Storyboard.TargetProperty="Color"
                                    To="#FF333D4C"
                                    Duration="0:0:0.1">
                                    <ColorAnimation.EasingFunction>
                                        <SineEase
                                            EasingMode="EaseInOut" />
                                    </ColorAnimation.EasingFunction>
                                </ColorAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
            </Border>
        </Grid>
        <Grid
            Margin="0,30,0,0"
            x:Name="MainArea"
            ClipToBounds="True"
            Panel.ZIndex="1">
            <Border
                Background="#FF303030"
                CornerRadius="5"
                Margin="10"
                Padding="5">
                <TextBlock
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    TextAlignment="Left"
                    TextWrapping="Wrap"
                    Text=""
                    FontFamily="Consolas,Microsoft YaHei"
                    FontSize="14"
                    FontWeight="Bold"
                    Foreground="#FFF0F0F0"
                    x:Name="InfoStd">
                </TextBlock>
            </Border>
            <Border
                VerticalAlignment="Top"
                HorizontalAlignment="Right"
                Background="#FF202020"
                BorderBrush="#FF404040"
                BorderThickness="2"
                CornerRadius="5"
                Width="25"
                Height="25"
                Margin="15">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Text="i"
                    FontFamily="Consolas"
                    FontSize="14"
                    FontWeight="Bold"
                    Foreground="#FF60CDFF"
                    x:Name="IconStd">
                </TextBlock>
            </Border>
        </Grid>
        <Grid.Effect>
            <DropShadowEffect
                BlurRadius="10"
                Color="#FF000000"
                Direction="270"
                Opacity="0.5"
                RenderingBias="Performance"
                ShadowDepth="0" />
        </Grid.Effect>
    </Grid>
</Window>
