<Window
    x:Class="NVIDIA_HDV.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:NVIDIA_HDV"
    xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    mc:Ignorable="d"
    Title="WebView2 Window"
    Width="1280"
    Height="720"
    Background="#FF202020"
    WindowStyle="SingleBorderWindow"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanResize"
    ShowActivated="True"
    ShowInTaskbar="True"
    KeyboardNavigation.TabNavigation="None"
    FocusVisualStyle="{x:Null}"
    Icon="/favicon.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="0"
            UseAeroCaptionButtons="False"
            NonClientFrameEdges="None"
            GlassFrameThickness="0,1,0,0"
            ResizeBorderThickness="5"
            CornerRadius="0">
        </WindowChrome>
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid
            Background="#FF303030"
            Height="30"
            VerticalAlignment="Top"
            ClipToBounds="False"
            x:Name="TITLE">
            <TextBlock
                Foreground="#FF808080"
                VerticalAlignment="Center"
                TextAlignment="Center"
                FontFamily="Consolas, Microsoft YaHei"
                FontSize="14"
                SnapsToDevicePixels="True"
                UseLayoutRounding="True"
                Margin="100,5,100,5"
                IsHitTestVisible="False"
                Text="{Binding Source.AbsoluteUri, ElementName=WebView24WPF, Mode=OneWay}"
                x:Name="NULLPART">
            </TextBlock>
            <Border
                Width="30"
                HorizontalAlignment="Right"
                Margin="0,0,1,0"
                x:Name="CLOSE">
                <Border.Background>
                    <SolidColorBrush
                        x:Name="CloseBG"
                        Color="#00C42B1C" />
                </Border.Background>
                <Path
                    Data="M0 0L10 10M0 10L10 0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Stroke="#FFF0F0F0"
                    StrokeThickness="1"
                    IsHitTestVisible="False" />
                <Border.Triggers>
                    <EventTrigger
                        RoutedEvent="Mouse.MouseEnter">
                        <BeginStoryboard
                            HandoffBehavior="SnapshotAndReplace">
                            <Storyboard
                                FillBehavior="HoldEnd">
                                <ColorAnimation
                                    Storyboard.TargetName="CloseBG"
                                    Storyboard.TargetProperty="Color"
                                    To="#FFC42B1C"
                                    Duration="0:0:0.1">
                                    <ColorAnimation.EasingFunction>
                                        <SineEase
                                            EasingMode="EaseInOut" />
                                    </ColorAnimation.EasingFunction>
                                </ColorAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger
                        RoutedEvent="Mouse.MouseLeave">
                        <BeginStoryboard
                            HandoffBehavior="SnapshotAndReplace">
                            <Storyboard
                                FillBehavior="HoldEnd">
                                <ColorAnimation
                                    Storyboard.TargetName="CloseBG"
                                    Storyboard.TargetProperty="Color"
                                    To="#00C42B1C"
                                    Duration="0:0:0.1">
                                    <ColorAnimation.EasingFunction>
                                        <SineEase
                                            EasingMode="EaseInOut" />
                                    </ColorAnimation.EasingFunction>
                                </ColorAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
            </Border>
            <Border
                Width="30"
                HorizontalAlignment="Right"
                Margin="0,0,31,0"
                x:Name="MINI">
                <Border.Background>
                    <SolidColorBrush
                        x:Name="MiniBG"
                        Color="#003D3D3D" />
                </Border.Background>
                <Path
                    Data="M0 0L10 0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Stroke="#FFF0F0F0"
                    StrokeThickness="1"
                    IsHitTestVisible="False" />
                <Border.Triggers>
                    <EventTrigger
                        RoutedEvent="Mouse.MouseEnter">
                        <BeginStoryboard
                            HandoffBehavior="SnapshotAndReplace">
                            <Storyboard
                                FillBehavior="HoldEnd">
                                <ColorAnimation
                                    Storyboard.TargetName="MiniBG"
                                    Storyboard.TargetProperty="Color"
                                    To="#FF3D3D3D"
                                    Duration="0:0:0.1">
                                    <ColorAnimation.EasingFunction>
                                        <SineEase
                                            EasingMode="EaseInOut" />
                                    </ColorAnimation.EasingFunction>
                                </ColorAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger
                        RoutedEvent="Mouse.MouseLeave">
                        <BeginStoryboard
                            HandoffBehavior="SnapshotAndReplace">
                            <Storyboard
                                FillBehavior="HoldEnd">
                                <ColorAnimation
                                    Storyboard.TargetName="MiniBG"
                                    Storyboard.TargetProperty="Color"
                                    To="#003D3D3D"
                                    Duration="0:0:0.1">
                                    <ColorAnimation.EasingFunction>
                                        <SineEase
                                            EasingMode="EaseInOut" />
                                    </ColorAnimation.EasingFunction>
                                </ColorAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
            </Border>
            <Border
                Width="30"
                HorizontalAlignment="Left"
                Margin="61,0,0,0"
                x:Name="HOME">
                <Border.Background>
                    <SolidColorBrush
                        x:Name="HOMEBG"
                        Color="#003D3D3D" />
                </Border.Background>
                <Path
                    Data="M5 0L0 4L0 10.5L3 10.5L3 7L7 7L7 10.5L10 10.5L10 4L5 0L0 4"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Stroke="#FFF0F0F0"
                    StrokeThickness="1"
                    IsHitTestVisible="False" />
                <Border.Triggers>
                    <EventTrigger
                        RoutedEvent="Mouse.MouseEnter">
                        <BeginStoryboard
                            HandoffBehavior="SnapshotAndReplace">
                            <Storyboard
                                FillBehavior="HoldEnd">
                                <ColorAnimation
                                    Storyboard.TargetName="HOMEBG"
                                    Storyboard.TargetProperty="Color"
                                    To="#FF3D3D3D"
                                    Duration="0:0:0.1">
                                    <ColorAnimation.EasingFunction>
                                        <SineEase
                                            EasingMode="EaseInOut" />
                                    </ColorAnimation.EasingFunction>
                                </ColorAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger
                        RoutedEvent="Mouse.MouseLeave">
                        <BeginStoryboard
                            HandoffBehavior="SnapshotAndReplace">
                            <Storyboard
                                FillBehavior="HoldEnd">
                                <ColorAnimation
                                    Storyboard.TargetName="HOMEBG"
                                    Storyboard.TargetProperty="Color"
                                    To="#003D3D3D"
                                    Duration="0:0:0.1">
                                    <ColorAnimation.EasingFunction>
                                        <SineEase
                                            EasingMode="EaseInOut" />
                                    </ColorAnimation.EasingFunction>
                                </ColorAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
            </Border>
            <Border
                Width="30"
                HorizontalAlignment="Left"
                Margin="31,0,0,0"
                x:Name="FLUSH">
                <Border.Background>
                    <SolidColorBrush
                        x:Name="FLUSHBG"
                        Color="#003D3D3D" />
                </Border.Background>
                <Path
                    Data="M10 6A 5,5 0 1 1 9.4,2.6M9.4 -0.4L9.4 2.6L6.4 2.6"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Stroke="#FFF0F0F0"
                    StrokeThickness="1"
                    IsHitTestVisible="False" />
                <Border.Triggers>
                    <EventTrigger
                        RoutedEvent="Mouse.MouseEnter">
                        <BeginStoryboard
                            HandoffBehavior="SnapshotAndReplace">
                            <Storyboard
                                FillBehavior="HoldEnd">
                                <ColorAnimation
                                    Storyboard.TargetName="FLUSHBG"
                                    Storyboard.TargetProperty="Color"
                                    To="#FF3D3D3D"
                                    Duration="0:0:0.1">
                                    <ColorAnimation.EasingFunction>
                                        <SineEase
                                            EasingMode="EaseInOut" />
                                    </ColorAnimation.EasingFunction>
                                </ColorAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger
                        RoutedEvent="Mouse.MouseLeave">
                        <BeginStoryboard
                            HandoffBehavior="SnapshotAndReplace">
                            <Storyboard
                                FillBehavior="HoldEnd">
                                <ColorAnimation
                                    Storyboard.TargetName="FLUSHBG"
                                    Storyboard.TargetProperty="Color"
                                    To="#003D3D3D"
                                    Duration="0:0:0.1">
                                    <ColorAnimation.EasingFunction>
                                        <SineEase
                                            EasingMode="EaseInOut" />
                                    </ColorAnimation.EasingFunction>
                                </ColorAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
            </Border>
            <Border
                Width="30"
                HorizontalAlignment="Left"
                Margin="1,0,0,0"
                x:Name="BACK">
                <Border.Background>
                    <SolidColorBrush
                        x:Name="BACKBG"
                        Color="#003D3D3D" />
                </Border.Background>
                <Path
                    Data="M10 5L0 5M5 0L0 5L5 10"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Stroke="#FFF0F0F0"
                    StrokeThickness="1"
                    IsHitTestVisible="False" />
                <Border.Triggers>
                    <EventTrigger
                        RoutedEvent="Mouse.MouseEnter">
                        <BeginStoryboard
                            HandoffBehavior="SnapshotAndReplace">
                            <Storyboard
                                FillBehavior="HoldEnd">
                                <ColorAnimation
                                    Storyboard.TargetName="BACKBG"
                                    Storyboard.TargetProperty="Color"
                                    To="#FF3D3D3D"
                                    Duration="0:0:0.1">
                                    <ColorAnimation.EasingFunction>
                                        <SineEase
                                            EasingMode="EaseInOut" />
                                    </ColorAnimation.EasingFunction>
                                </ColorAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger
                        RoutedEvent="Mouse.MouseLeave">
                        <BeginStoryboard
                            HandoffBehavior="SnapshotAndReplace">
                            <Storyboard
                                FillBehavior="HoldEnd">
                                <ColorAnimation
                                    Storyboard.TargetName="BACKBG"
                                    Storyboard.TargetProperty="Color"
                                    To="#003D3D3D"
                                    Duration="0:0:0.1">
                                    <ColorAnimation.EasingFunction>
                                        <SineEase
                                            EasingMode="EaseInOut" />
                                    </ColorAnimation.EasingFunction>
                                </ColorAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
            </Border>
        </Grid>
        <Grid
            Margin="0,30,0,0">
            <wv2:WebView2CompositionControl
                Name="WebView24WPF"
                Source="{x:Null}"
                Background="#FF202020"
                Foreground="#FFC0C0C0"
                AllowExternalDrop="False"
                ClipToBounds="True"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollBarVisibility="Auto" />
        </Grid>
    </Grid>
</Window>
